         [math]::Round(((Get-Date) - $networkSnapshotStartedAt).TotalMilliseconds), `
         [math]::Round(((Get-Date) - $baseProcessStartedAt).TotalMilliseconds)) "INFO"
     Write-BaseCapLog "Local network context: ssid='$($netCtx.ssid)' ip='$($netCtx.ip)' gw='$($netCtx.gw)' dns='$($netCtx.dns)'" "INFO"
