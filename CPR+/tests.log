# Configuration
$LogPath               = "C:\ProgramData\WhiteWalker\logs\white_walker.cap_portal_base.log"
$FlagFile              = "C:\ProgramData\WhiteWalker\portal_complete.flag"
# ---------------------------------------------------------------------------
# FAIL-SAFE DEFAULTS ONLY (RC2.2, Required E).
