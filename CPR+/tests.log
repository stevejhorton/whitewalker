$BaseAllowFullEscalation = $false
# A handoff artifact older than this no longer describes the live network.
$MaxHandoffAgeSeconds  = 900
$StateDir              = "C:\ProgramData\WhiteWalker"
$LogDir                = Join-Path $StateDir "logs"
